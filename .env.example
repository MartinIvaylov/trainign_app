# =============================================================================
# HYBRID Performance Platform — environment variables
# =============================================================================
# Copy to `.env` and fill in real values. Never commit `.env`. In Vercel, set
# these in the project settings (or via the Vercel CLI); the `@<name>` syntax
# in `vercel.json` references Vercel Project Environment Variables.
# =============================================================================

# Database (production: Supabase Postgres; dev: SQLite)
DATABASE_URL="file:./db/custom.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production-min-32-chars"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Stripe
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_PRO_MONTHLY="price_xxx"
STRIPE_PRICE_PRO_ANNUAL="price_xxx"
STRIPE_PRICE_COACH="price_xxx"
STRIPE_PRICE_GYM="price_xxx"

# AI Coach (server-side only — never expose to client)
ZAI_API_KEY="your-zai-key"

# Cron
CRON_SECRET="random-secret-for-cron-auth"

# Mobile (Expo)
EXPO_PUBLIC_API_URL="https://your-domain.com"
