# =============================================================================
# HYBRID Performance Platform — environment variables
# =============================================================================
# Copy to `.env` and fill in real values. Never commit `.env`. In Vercel, set
# these in the project settings (or via the Vercel CLI); the `@<name>` syntax
# in `vercel.json` references Vercel Project Environment Variables.
# =============================================================================

# Database (production: Supabase Postgres; dev: SQLite)
DATABASE_URL="file:./db/custom.db"

# Auth — signs the httpOnly session cookie. REQUIRED in production
# (>= 32 random chars, e.g. `openssl rand -hex 32`). Without it, dev uses a
# random per-process secret and sessions reset on restart.
AUTH_SECRET=""   # NEXTAUTH_SECRET is accepted as a fallback

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Stripe — checkout, portal and webhooks are disabled (503) unless both
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are set.
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_PRO_MONTHLY="price_xxx"
STRIPE_PRICE_PRO_ANNUAL="price_xxx"
STRIPE_PRICE_COACH="price_xxx"
STRIPE_PRICE_GYM="price_xxx"

# Local development only: grant plans WITHOUT payment so billing UI can be
# exercised without Stripe. Ignored when NODE_ENV=production.
# BILLING_PREVIEW_MODE="true"

# AI Coach (server-side only — never expose to client)
ZAI_API_KEY="your-zai-key"

# Cron
CRON_SECRET="random-secret-for-cron-auth"

# Mobile (Expo)
EXPO_PUBLIC_API_URL="https://your-domain.com"
